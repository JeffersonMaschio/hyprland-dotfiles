{
    "layer": "top",
    "position": "top",
    "height": 40,
    "margin": "0",
    "spacing": 4,
    "exclusive": true,

    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["group/player"],
    "modules-right": ["cpu", "battery", "network", "clock"],

    "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
       	"persistent_workspaces": {
			"1": [],
			"2": [],
			"3": [],
			"4": [],
			"5": []
       	},
        "format-icons": {
            "1": "I",
            "2": "II",
            "3": "III",
            "4": "IV",
            "5": "V",
            "6": "VI",
            "7": "VII",
            "8": "VIII",
            "9": "IX",
            "10": "X",
            "11": "XI",
            "12": "XII",
            "default": "\u00b7"
        },
        "sort-by-name": true
    },

    "group/player": {
        "orientation": "horizontal",
        "modules": ["custom/media-prev", "custom/media-play", "custom/media-next", "custom/media-info"]
    },

    "custom/media-prev": {
        "format": "\uf048",
        "on-click": "playerctl previous",
        "tooltip": false
    },

    "custom/media-play": {
        "format": "{}",
        "return-type": "json",
        "exec": "~/.config/waybar/scripts/media-play.sh",
        "restart-interval": 1,
        "exec-on-event": false,
        "on-click": "playerctl play-pause",
        "tooltip": false
    },

    "custom/media-info": {
        "format": "{}",
        "return-type": "json",
        "exec": "~/.config/waybar/scripts/media.sh",
        "restart-interval": 1,
        "exec-on-event": false,
        "justify": "left",
        "align": 0,
        "tooltip": false
    },

    "custom/media-next": {
        "format": "\uf051",
        "on-click": "playerctl next",
        "tooltip": false
    },

    "cpu": {
        "format": "\uf2db {usage}%",
        "interval": 3,
        "tooltip": false,
        "cursor": true,
        "on-click": "kitty -e btop"
    },

    "battery": {
    	"states": {
    		"good": 85,
    		"warning": 40,
    		"critical": 15
    	},
    	"format": "{icon} {capacity}%",
    	"format-full": "{icon} {capacity}%",
    	"format-plugged": "󰂄 {capacity}%",
    	"format-charging": "󰂄 {capacity}%",
    	"format-alt": "{icon} {capacity}%",
    	"format-icons": ["", "", "", "", ""],
    	"tooltip-format": "{time}",
    	"cursor": false,
    },

    "network": {
        "format-wifi": "<span foreground='#D95F3B'> </span> \u2193{bandwidthDownBytes}",
        "format-ethernet": "<span foreground='#D95F3B'>󰈀 </span> \u2193{bandwidthDownBytes}",
        "format-disconnected": "\u2717",
        "interval": 2,
        "tooltip-format-wifi": "{essid} {signalStrength}%",
        "on-click": "nmgui"
    },

    "clock": {
        "format": "{:%a, %d %b | %H:%M}",
        "tooltip": false,
        "on-click": "swaync-client -t -sw"
    }
}
