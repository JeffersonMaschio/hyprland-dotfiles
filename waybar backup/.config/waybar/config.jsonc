{
    "modules-left": ["hyprland/workspaces", "custom/sep", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right": ["custom/recorder", "tray", "network", "battery", "pulseaudio", "cpu"],

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "warp-on-scroll": false,
        "format": "{name}",
        "cursor": true,
        "persistent-workspaces": {
                "*": [1, 2, 3, 4, 5]
            },
    },
    
	 "custom/sep": {
        "format": "{}",
        "interval": 1,
        "exec": "if [ \"$(hyprctl activewindow -j | jq -r '.title')\" != \"null\" ]; then echo \" | \"; else echo \"\"; fi",
        "tooltip": false
    },
    
	
	"hyprland/window": {
		"format": "{title}",
		"separate-outputs": true,
		"icon": true,
		"icon-size": 15,
		"tooltip": false,
		"rewrite": {
		    "^\\s*$": ""
		}
	},

/*===================================================================================*/	

    "clock": {
        "format": "{:%H:%M - %A, %d/%m/%Y}", /* 19:20 - Tuesday, 12/05/2026 */
        "tooltip-format": "<span size='14000'><tt>{calendar}</tt></span>",
        "interval": 1,
        "calendar": {
            "mode": "month",
            "format": {
                "months": "<span color='#89B4FA'><b>{}</b></span>",
                "weekdays": "<span color='#5CB85C'><b>{}</b></span>",
                "days": "<span color='#CDD6F4'><b>{}</b></span>",
                "today": "<span color='#F0AD4E'><b>{}</b></span>",
            }
        },
        "on-click": "swaync-client -t -sw",
    },
    
/*===================================================================================*/	

	"custom/recorder": {
	    "interval": 2,
	    "exec": "pgrep -x wf-recorder >/dev/null && echo '● REC'",
	    "on-click": "pkill -INT wf-recorder",
	    "tooltip": false
	},

    "tray": {
        "icon-size": 20,
        "spacing": 10,
        "cursor": true,
    },

    "network": {
		"interface": "wlan0",
        "format-wifi": " {essid}",
        "format-ethernet": " Ethernet",
        "format-linked": " Linked (No IP)",
        "format-disconnected": " Disconnected",
        "tooltip-format-wifi": "{essid} ({frequency} GHz)\n⇣{bandwidthDownBits}  ⇡{bandwidthUpBits}",
        "tooltip-format-ethernet": "⇣{bandwidthDownBits}  ⇡{bandwidthUpBits}",
		"interval": 2,
		"spacing": 1,
        "tooltip": true,
        "on-click": "nmgui",
    },

    "battery": {
        "states": {
            "good": 85,
            "warning": 40,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-full": "{icon} {capacity}%",
        "format-plugged": " {capacity}%",
        "format-charging": " {capacity}%",
        "format-alt": "{icon} {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "tooltip-format": "{time}",
        "cursor": false,
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": " {volume}%",
        "format-bluetooth": " {volume}%",
        "format-bluetooth-muted": " {volume}%",
        "format-icons": {
            "headphone": "",
            "headset": "",
            "default": [""],
        },
        "on-click": "kitty -e wiremix",
    },

	"cpu": {
		"format": "",
		"tooltip": true,
		"interval": 2,
		"on-click": "kitty -e btop",	
	}

}
