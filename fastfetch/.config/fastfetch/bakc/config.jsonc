// keyColor 34 - blue - default


{
//	"$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
    	"source": "~/.config/fastfetch/MusashiIcon.jpg",
    	"type": "kitty", 
    	"height": 12,
    	"padding": {
    		"left": 1
    	}
    },



//	"logo": {
//		"source": "arch_small",
//		"padding": {
//			"top": 2,
//			"left": 5
//		},	
//	},
	
    "display": {
        "separator": "- "
    },
    
    "modules": [
		{
            "type": "title",
            "keyWidth": 10
        },
        {
           "type": "custom",
           "format": "┌───────────────────────────────────────┐",
		   "color": "white",
        },
        {
            "type": "os",
            "key": "   OS ",
            "keyColor": "90",  // = color4
        },
        {
            "type": "kernel",
            "key": "   Kernel ",
            "keyColor": "90",
        },
        {
            "type": "packages",
            "format": "{} (pacman)",
            "key": "   Packages ",
            "keyColor": "90",  
        },
		{
			"type": "memory",
			"key": "  󰍛 Memory ",
			"keyColor": "90",	
		},
        {
            "type": "wm",
            "key": "   WM ",
            "keyColor": "90", 
        },
        {
            "type": "uptime",
            "key": "  󱣺 UpTime ",
            "keyColor": "90", 
        },
        {
            "type": "datetime",
            "format": "{23}/{4}/{1}",
            "key": "   DateTime ",
            "keyColor": "90", 
        },
        {
            "type": "datetime",
            "format": "{14}:{18}",
            "key": "   CurrentTime ",
            "keyColor": "90", 
        },
   		{
   			"type": "custom",
   			"format": "└───────────────────────────────────────┘",
   			"color": "white",
   		},
        {
            "type": "custom",
            "format": "  \u001b[31m  \u001b[32m  \u001b[33m  \u001b[34m  \u001b[35m  \u001b[36m  \u001b[37m  "
        },

    ]
}

